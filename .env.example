# Easiest: run `npm run setup` and answer the questions. Or copy this file to .env and edit.
OPENAI_API_KEY=sk-paste-your-key-here

# Shown on the TV
# PARTY_TITLE=The Monster Bash
# PARTY_SUB=123 Elm Street · Oct 31

# Hosts get a glamour portrait instead of a monster (first names, comma separated)
# VIP_NAMES=alex,sam

# Costume contest
# VOTE_CLOSE=23:00        (HH:MM 24h, or off)
# VOTE_LIMIT=3
# JUDGE_SEARCH=1          (judge web-searches the costume first)
# JUDGE_MODEL=gpt-4o-mini

# Models and speed
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium    (low | medium | high)
# TEXT_MODEL=gpt-4o-mini
# MAX_PARALLEL=4
# AI_PROMPTS=0            (turn off the per-guest AI-written concepts)

# Group scenes: guests partying in front of the background image (as monsters, and as themselves in costume)
# SCENE=0                 (all group scenes off)
# SCENE_COSTUME=0         (only the monster scenes)
# SCENE_MAX=15
# SCENE_QUALITY=medium
# BACKGROUND=bg.jpg       (any image in public/, e.g. bg-graveyard.jpg or a photo of your house)

# Wi-Fi QR code on the TV and printed signs (password never leaves this computer)
# WIFI_NAME=MyWifi
# WIFI_PASSWORD=secret

# Misc
# PORT=3000
# ALBUM_DIR=album
# PUBLIC_URL=https://xyz.ngrok.app   (if guests connect through a tunnel)
# DEMO=1                  (force demo mode even with a key)
